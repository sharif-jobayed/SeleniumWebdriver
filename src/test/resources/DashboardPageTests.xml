<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Dashboard page tests" parallel="true" verbose="2">

    <test name="Login and Dashboard tests">

        <classes>
            <class name="tests.LoginPageTest">
                <methods>
                    <include name="loginWithValidCredentials" />
                </methods>
            </class>

            <class name="tests.DashboardPageTest">
                <methods>
                    <include name="isDashboardPageOpen" />
                    <include name="isLanguageEnglish" />
                    <include name="clickViewLeaveList" />
                </methods>
            </class>
        </classes>

    </test>

</suite>

<suite name="Login page test suite" verbose="2" parallel="methods" thread-count="1">

    <test name="Login Page Tests">
        <!-- Login Page Tests -->
        <classes>

            <class name="tests.LoginPageTest">
                <methods>
                    <method name="loginUsingValidCredentials"/>
                    <method name="loginUsingInvalidUsernameAndValidPassword"/>
                    <method name="loginUsingValidUsernameAndInvalidPassword"/>

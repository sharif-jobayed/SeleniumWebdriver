<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Login page tests" verbose="2" parallel="methods" thread-count="2">

    <!-- Login Page Tests -->
    <test name="Dashboard Page Tests">

        <classes>
            <class name="tests.LoginPageTest">
                <methods>
                    <include name="loginToAppWithValidCredentials" />
                </methods>
            </class>

            <class name="tests.DashboardPageTest">
                <methods>
                    <include name="appLanguageIsEnglish" />
                </methods>
            </class>
        </classes>

    </test>

</suite>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Login page tests" verbose="2" parallel="methods" thread-count="1">

    <test name="Dashboard Page Tests">

        <!-- Login Page Tests -->
        <classes>
            <class name="tests.LoginPageTest">
                <methods>
                    <include name="loginToAppWithValidCredentials"/>
                </methods>
            </class>

            <!-- Dashboard Page Tests -->
            <class name="tests.DashboardPageTest">
                <methods>
                    <include name="appLanguageIsEnglish"/>
                </methods>
            </class>
        </classes>

    </test>

</suite>

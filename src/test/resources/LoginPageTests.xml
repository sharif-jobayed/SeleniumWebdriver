<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Login page tests" verbose="2" parallel="methods" thread-count="1">

    <!-- Login Page Tests -->
    <test name="Login Page Tests">

        <classes>
            <class name="tests.LoginPageTest">
                <methods>
                    <include name="loginWithValidCredentials" />
                    <include name="loginWithInvalidUsername" />
                    <include name="loginWithInvalidPassword" />
                    <include name="loginWithInvalidUserNameAndPassword"/>
                    <include name="isBannerDisplayed" />
                </methods>
            </class>
        </classes>

    </test>

</suite>
